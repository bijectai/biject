# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# REQUIRED. base64 of a 32-byte Ed25519 seed. biject-api raises at import time
# when this is unset — there is no ephemeral-key fallback, and the whole stack
# will not start without it.
#
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#
# Rotating this invalidates every prior signature and breaks chain continuity
# for all existing ledger entries. A rotation needs a documented chain-migration
# plan before it happens, not after.
AUDIT_SIGNING_KEY=

# The PUBLIC half of the key above, base64 or hex, so biject-trace can verify
# signatures. Optional: unset means hash linkage is checked but signatures are
# not, and every /v1/verify response says so.
AUDIT_VERIFY_PUBKEY=

# ---------------------------------------------------------------------------
# biject-proxy's forwarding allowlist: name=url,name=url
#
# Empty by default. A proxy should not come up able to reach anything until
# someone decides what it may reach; until this is set, every forward is refused
# with `unknown_target`. Callers name a target — they never supply a URL.
PROXY_TARGETS=

VERIFY_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Optional
ORACLE_SIGNING_KEY=
ANTHROPIC_API_KEY=
ARISTOTLE_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
JUDGE_BACKEND=heuristic
