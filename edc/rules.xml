  <!-- ============================== RuleDefs ============================= -->
  <!-- Range rules: relational operators on an empty value raise an internal
       exception and the rule is skipped for that subject, so these are safe
       when the item is absent; emptiness is caught by the eq "" rules. -->

  <RuleDef OID="R_SBP_RANGE" Name="SBP plausible range 80-200">
    <Description>Systolic BP outside 80-200 mmHg.</Description>
    <Expression>(I_VITAL_SBP lt 80) or (I_VITAL_SBP gt 200)</Expression>
  </RuleDef>

  <RuleDef OID="R_WEIGHT_RANGE" Name="Weight plausible range 30-250">
    <Description>Adult body weight outside 30-250 kg.</Description>
    <Expression>(I_VITAL_WEIGHT lt 30) or (I_VITAL_WEIGHT gt 250)</Expression>
  </RuleDef>

  <!-- Cross-field consistency: computed BMI = weight_kg * 10000 / height_cm^2.
       Tolerance +/-3 kg/m2: clean seed subjects sit within 0.3 of their
       recorded BMI, decimal-shift weights land orders of magnitude outside.
       If BMI or height is absent the arithmetic raises and the rule is
       skipped (no false positive on the unresolvable no-BMI subject). -->
  <RuleDef OID="R_WEIGHT_BMI" Name="Weight vs BMI consistency">
    <Description>Recorded weight disagrees with site-calculated BMI and height by more than 3 kg/m2.</Description>
    <Expression>(I_VITAL_WEIGHT * 10000 / (I_VITAL_HEIGHT * I_VITAL_HEIGHT) gt I_VITAL_BMI + 3) or (I_VITAL_WEIGHT * 10000 / (I_VITAL_HEIGHT * I_VITAL_HEIGHT) lt I_VITAL_BMI - 3)</Expression>
  </RuleDef>

  <!-- Cross-event date order. The right-hand operand is a FULL path into
       SE_SCREENING and resolves from the DB - seed.py imports Screening in a
       separate, earlier SOAP call so this is populated when visit events are
       imported. The left-hand operand is partial and resolves relative to
       each assignment's target (works for both SE_VISIT1 and SE_VISIT2). -->
  <RuleDef OID="R_VISITDATE_ORDER" Name="Visit date before screening date">
    <Description>Assessment date precedes the screening/consent date on the Screening Demographics CRF.</Description>
    <Expression>I_VITAL_VISITDATE lt SE_SCREENING.F_DEMOG.IG_DEMOG_UNGROUPED.I_DEMOG_SCREENDATE</Expression>
  </RuleDef>

  <!-- Empty-field rules. seed.py imports the planted-missing items with an
       explicit empty Value="" so an item_data row exists for the note to
       attach to (the ws import accepts blank values; blanks skip the
       type/width hard checks). -->
  <RuleDef OID="R_DBP_MISSING" Name="DBP missing">
    <Description>Diastolic BP left empty although required.</Description>
    <Expression>I_VITAL_DBP eq ""</Expression>
  </RuleDef>

  <RuleDef OID="R_SEX_MISSING" Name="Sex missing">
    <Description>Sex left empty although required.</Description>
    <Expression>I_DEMOG_SEX eq ""</Expression>
  </RuleDef>

  <RuleDef OID="R_HGB_MISSING" Name="Hemoglobin missing">
    <Description>Hemoglobin left empty although required.</Description>
    <Expression>I_LABS_HGB eq ""</Expression>
  </RuleDef>

  <RuleDef OID="R_HGB_RANGE" Name="Hemoglobin plausible range 5-20">
    <Description>Hemoglobin outside 5-20 g/dL (unit or decimal shift suspected).</Description>
    <Expression>(I_LABS_HGB lt 5) or (I_LABS_HGB gt 20)</Expression>
  </RuleDef>

  <RuleDef OID="R_WBC_RANGE" Name="WBC plausible range 1-50">
    <Description>WBC outside 1-50 x10^9/L.</Description>
    <Expression>(I_LABS_WBC lt 1) or (I_LABS_WBC gt 50)</Expression>
  </RuleDef>

  <RuleDef OID="R_CREAT_RANGE" Name="Creatinine plausible range 0.2-10">
    <Description>Serum creatinine outside 0.2-10 mg/dL (decimal shift suspected).</Description>
    <Expression>(I_LABS_CREAT lt 0.2) or (I_LABS_CREAT gt 10)</Expression>
  </RuleDef>

</RuleImport>
