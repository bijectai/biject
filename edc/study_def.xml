<?xml version="1.0" encoding="UTF-8"?>
<!--
  study_def.xml - ODM 1.3 study metadata for the synthetic Phase II demo
  study "BJT-DEMO-01" (StudyOID S_BJTDEMO). 100% SYNTHETIC - no real study,
  site, subject, or PHI data anywhere in this file.

  ROLE OF THIS FILE: documentation of record for the study structure. OC 3.17
  cannot import ODM study metadata; the study is built MANUALLY in the OC UI
  from Excel CRF templates (see edc/README.md for the exact click path and the
  exact names that make OC auto-generate the OIDs below). This file is the
  single source of truth that seed_data.xml, rules.xml and
  query_resolution_map.md are written against.

  STRUCTURE: three non-repeating scheduled events, three CRFs:
    SE_SCREENING : F_DEMOG  (demographics + screening date + enrollment note)
                   F_VITALS (baseline vitals)
    SE_VISIT1    : F_VITALS, F_LABS
    SE_VISIT2    : F_VITALS, F_LABS   (repeat lab draw - the source of truth
                                       for the out-of-range-lab query class)

  NO SOFT EDIT CHECKS - DELIBERATE (source-verified against OC 3.17.2):
  In the OpenClinica-ws SOAP import path, DataImportService.validateData
  (ws/.../DataImportService.java:187-193) treats SOFT validation errors
  (CRF VALIDATION column / ODM RangeCheck) the same as hard errors: any soft
  violation makes the ENTIRE importData call return <result>Fail</result> and
  nothing is written. The previous revision of this file carried Soft
  RangeChecks on every numeric item; those would have rejected the messy seed
  data outright. Queries therefore come from the RULES ENGINE instead:
  rules.xml carries DiscrepancyNoteAction rules with Run ImportDataEntry=
  "true", which DO fire during SOAP import and auto-create open
  Failed Validation Check discrepancy notes (docs "Data Web Service" +
  "Import Data" pages; source chain DataEndpoint -> runRulesSetup ->
  ImportDataRuleRunner -> DiscrepancyNoteActionProcessor).
  => When building the CRF Excel templates, leave the VALIDATION and
     WIDTH_DECIMAL columns EMPTY (width/decimal violations are HARD errors on
     import and would also reject seeded values such as weight "703").

  OID DERIVATION (matches OC 3.17.2 bean/oid/*OidGenerator.java exactly;
  README.md gives the UI names that produce them):
    Study     "S_" + first 8 alnum chars of Unique Protocol ID
              -> Unique Protocol ID "BJT-DEMO"        => S_BJTDEMO
    Event     "SE_" + first 28 alnum chars of event name
              -> "Screening"/"Visit 1"/"Visit 2"      => SE_SCREENING,
                                                         SE_VISIT1, SE_VISIT2
    CRF       "F_" + first 12 alnum chars of CRF name
              -> "DEMOG"/"VITALS"/"LABS"              => F_DEMOG, F_VITALS,
                                                         F_LABS
    CRF ver   CRF OID + "_" + first 10 alnum chars of version name
              -> version "v1.0"                       => F_DEMOG_V10,
                                                         F_VITALS_V10,
                                                         F_LABS_V10
              (ClinicalData/FormData@FormOID in seed_data.xml MUST use these
               version OIDs - the ws import resolves FormOID against
               crf_version.oc_oid, not the CRF-level OID)
    Group     "IG_" + first 5 of CRF name + "_UNGROUPED" for items left
              ungrouped in the Excel                  => IG_DEMOG_UNGROUPED,
                                                         IG_VITAL_UNGROUPED,
                                                         IG_LABS_UNGROUPED
    Item      "I_" + first 5 alnum chars of CRF name + "_" + item name
              (note: "VITALS" truncates to "VITAL")   => I_DEMOG_*, I_VITAL_*,
                                                         I_LABS_*
    Subject   "SS_" + first 8 alnum chars of Study Subject ID
              -> IDs "001".."014"                     => SS_001..SS_014

  The FormDef OIDs below are the CRF-level OIDs (F_DEMOG / F_VITALS / F_LABS);
  the per-version OIDs used on the wire are listed beside each FormDef.
-->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:OpenClinica="http://www.openclinica.org/ns/odm_ext_v130/v3.1"
     FileType="Snapshot"
     FileOID="BJT-DEMO-01-METADATA"
     Description="BJT-DEMO-01 synthetic Phase II demo study metadata"
     CreationDateTime="2026-08-21T00:00:00"
     ODMVersion="1.3">
  <Study OID="S_BJTDEMO">
    <GlobalVariables>
      <StudyName>BJT-DEMO-01</StudyName>
      <StudyDescription>
        Synthetic Phase II demo study for the biject clinical-trial query
        resolution demo. All data is fabricated; no real PHI.
      </StudyDescription>
      <ProtocolName>BJT-DEMO-01</ProtocolName>
    </GlobalVariables>
    <BasicDefinitions/>
    <MetaDataVersion OID="v1.0.0" Name="BJT-DEMO-01 v1.0.0">
      <Protocol>
        <StudyEventRef StudyEventOID="SE_SCREENING" OrderNumber="1" Mandatory="Yes"/>
        <StudyEventRef StudyEventOID="SE_VISIT1" OrderNumber="2" Mandatory="Yes"/>
        <StudyEventRef StudyEventOID="SE_VISIT2" OrderNumber="3" Mandatory="Yes"/>
      </Protocol>

      <StudyEventDef OID="SE_SCREENING" Name="Screening" Repeating="No" Type="Scheduled">
        <FormRef FormOID="F_DEMOG" Mandatory="Yes"/>
        <FormRef FormOID="F_VITALS" Mandatory="Yes"/>
      </StudyEventDef>
      <StudyEventDef OID="SE_VISIT1" Name="Visit 1" Repeating="No" Type="Scheduled">
        <FormRef FormOID="F_VITALS" Mandatory="Yes"/>
        <FormRef FormOID="F_LABS" Mandatory="Yes"/>
      </StudyEventDef>
      <StudyEventDef OID="SE_VISIT2" Name="Visit 2" Repeating="No" Type="Scheduled">
        <FormRef FormOID="F_VITALS" Mandatory="Yes"/>
        <FormRef FormOID="F_LABS" Mandatory="Yes"/>
      </StudyEventDef>

      <!-- CRF "DEMOG" v1.0 -> version OID F_DEMOG_V10 (used in FormData) -->
      <FormDef OID="F_DEMOG" Name="Demographics" Repeating="No">
        <ItemGroupRef ItemGroupOID="IG_DEMOG_UNGROUPED" Mandatory="Yes"/>
      </FormDef>
      <!-- CRF "VITALS" v1.0 -> version OID F_VITALS_V10 (used in FormData) -->
      <FormDef OID="F_VITALS" Name="Vital Signs" Repeating="No">
        <ItemGroupRef ItemGroupOID="IG_VITAL_UNGROUPED" Mandatory="Yes"/>
      </FormDef>
      <!-- CRF "LABS" v1.0 -> version OID F_LABS_V10 (used in FormData) -->
      <FormDef OID="F_LABS" Name="Laboratory" Repeating="No">
        <ItemGroupRef ItemGroupOID="IG_LABS_UNGROUPED" Mandatory="Yes"/>
      </FormDef>

      <ItemGroupDef OID="IG_DEMOG_UNGROUPED" Name="Demographics (ungrouped)"
                    Repeating="No" SASDatasetName="DEMOG">
        <ItemRef ItemOID="I_DEMOG_SCREENDATE" OrderNumber="1" Mandatory="Yes"/>
        <ItemRef ItemOID="I_DEMOG_AGE" OrderNumber="2" Mandatory="Yes"/>
        <ItemRef ItemOID="I_DEMOG_SEX" OrderNumber="3" Mandatory="Yes"/>
        <ItemRef ItemOID="I_DEMOG_ENROLLNOTE" OrderNumber="4" Mandatory="No"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG_VITAL_UNGROUPED" Name="Vital Signs (ungrouped)"
                    Repeating="No" SASDatasetName="VITALS">
        <ItemRef ItemOID="I_VITAL_VISITDATE" OrderNumber="1" Mandatory="Yes"/>
        <ItemRef ItemOID="I_VITAL_SBP" OrderNumber="2" Mandatory="Yes"/>
        <ItemRef ItemOID="I_VITAL_DBP" OrderNumber="3" Mandatory="Yes"/>
        <ItemRef ItemOID="I_VITAL_HR" OrderNumber="4" Mandatory="Yes"/>
        <ItemRef ItemOID="I_VITAL_WEIGHT" OrderNumber="5" Mandatory="Yes"/>
        <ItemRef ItemOID="I_VITAL_HEIGHT" OrderNumber="6" Mandatory="Yes"/>
        <ItemRef ItemOID="I_VITAL_BMI" OrderNumber="7" Mandatory="No"/>
        <ItemRef ItemOID="I_VITAL_NOTE" OrderNumber="8" Mandatory="No"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG_LABS_UNGROUPED" Name="Laboratory (ungrouped)"
                    Repeating="No" SASDatasetName="LABS">
        <ItemRef ItemOID="I_LABS_COLLDATE" OrderNumber="1" Mandatory="Yes"/>
        <ItemRef ItemOID="I_LABS_HGB" OrderNumber="2" Mandatory="Yes"/>
        <ItemRef ItemOID="I_LABS_WBC" OrderNumber="3" Mandatory="Yes"/>
        <ItemRef ItemOID="I_LABS_CREAT" OrderNumber="4" Mandatory="Yes"/>
        <ItemRef ItemOID="I_LABS_SOURCE_NOTE" OrderNumber="5" Mandatory="No"/>
      </ItemGroupDef>

      <!-- ====================== Demographics items ======================= -->
      <!-- Screening/consent date. AUTHORITATIVE anchor for the date-order
           query class: rules.xml flags any visit date earlier than this. -->
      <ItemDef OID="I_DEMOG_SCREENDATE" Name="SCREENDATE" DataType="date">
        <Question><TranslatedText xml:lang="en">Screening / informed consent date</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_DEMOG_AGE" Name="AGE" DataType="integer">
        <Question><TranslatedText xml:lang="en">Age at screening (years)</TranslatedText></Question>
      </ItemDef>
      <!-- Plain text (M/F), not a radio/response set: response-set mismatches
           are HARD import errors in the ws path; text keeps the planted
           empty-value import safe. -->
      <ItemDef OID="I_DEMOG_SEX" Name="SEX" DataType="text">
        <Question><TranslatedText xml:lang="en">Sex (M/F)</TranslatedText></Question>
      </ItemDef>
      <!-- Transcription of the paper enrollment log: the recoverable source
           for the missing-required-field query class on this CRF. -->
      <ItemDef OID="I_DEMOG_ENROLLNOTE" Name="ENROLLNOTE" DataType="text">
        <Question><TranslatedText xml:lang="en">Enrollment log transcription (source document)</TranslatedText></Question>
      </ItemDef>

      <!-- ======================= Vital Signs items ======================= -->
      <ItemDef OID="I_VITAL_VISITDATE" Name="VISITDATE" DataType="date">
        <Question><TranslatedText xml:lang="en">Date of assessment</TranslatedText></Question>
      </ItemDef>
      <!-- Plausible ranges are enforced by rules.xml (SBP 80-200 etc.), NOT
           by RangeChecks here - see the header comment for why. -->
      <ItemDef OID="I_VITAL_SBP" Name="SBP" DataType="integer">
        <Question><TranslatedText xml:lang="en">Systolic blood pressure (mmHg)</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_VITAL_DBP" Name="DBP" DataType="integer">
        <Question><TranslatedText xml:lang="en">Diastolic blood pressure (mmHg)</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_VITAL_HR" Name="HR" DataType="integer">
        <Question><TranslatedText xml:lang="en">Heart rate (beats/min)</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_VITAL_WEIGHT" Name="WEIGHT" DataType="float">
        <Question><TranslatedText xml:lang="en">Body weight (kg)</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_VITAL_HEIGHT" Name="HEIGHT" DataType="float">
        <Question><TranslatedText xml:lang="en">Height (cm)</TranslatedText></Question>
      </ItemDef>
      <!-- Site-calculated BMI. Together with HEIGHT it makes a wrong WEIGHT
           RECOVERABLE: weight_kg = BMI * (height_m)^2. rules.xml carries the
           weight-vs-BMI consistency rule over these three items. -->
      <ItemDef OID="I_VITAL_BMI" Name="BMI" DataType="float">
        <Question><TranslatedText xml:lang="en">Body mass index (kg/m2, site-calculated)</TranslatedText></Question>
      </ItemDef>
      <!-- Transcription of the paper vitals chart: recoverable source for
           missing/garbled vitals values. -->
      <ItemDef OID="I_VITAL_NOTE" Name="NOTE" DataType="text">
        <Question><TranslatedText xml:lang="en">Vitals chart transcription (source document)</TranslatedText></Question>
      </ItemDef>

      <!-- ======================== Laboratory items ======================= -->
      <ItemDef OID="I_LABS_COLLDATE" Name="COLLDATE" DataType="date">
        <Question><TranslatedText xml:lang="en">Sample collection date</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_LABS_HGB" Name="HGB" DataType="float">
        <Question><TranslatedText xml:lang="en">Hemoglobin (g/dL)</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_LABS_WBC" Name="WBC" DataType="float">
        <Question><TranslatedText xml:lang="en">White blood cell count (10^9/L)</TranslatedText></Question>
      </ItemDef>
      <ItemDef OID="I_LABS_CREAT" Name="CREAT" DataType="float">
        <Question><TranslatedText xml:lang="en">Serum creatinine (mg/dL)</TranslatedText></Question>
      </ItemDef>
      <!-- Transcription of the central-lab report line: recoverable source
           for unit/decimal-shift and missing lab values. -->
      <ItemDef OID="I_LABS_SOURCE_NOTE" Name="SOURCE_NOTE" DataType="text">
        <Question><TranslatedText xml:lang="en">Central lab report transcription (source document)</TranslatedText></Question>
      </ItemDef>
    </MetaDataVersion>
  </Study>
</ODM>
