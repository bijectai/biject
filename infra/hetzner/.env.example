# =============================================================================
# biject sprint demo — environment template (S4-D-10 / S4-D-11)
# =============================================================================
# Copy to `.env` next to docker-compose.yml and fill in REAL values there:
#
#     cp .env.example .env && chmod 600 .env
#
# The real `.env` is NEVER committed (add it to .gitignore). In Coolify Raw
# Compose mode you can alternatively set these as resource Environment
# Variables — same names.
#
# This single file feeds BOTH compose projects:
#   * ./docker-compose.yml                            (picked up automatically)
#   * ./openclinica/docker-compose.openclinica.yml    (pass --env-file ../.env)
# =============================================================================

# --- Domain / TLS ------------------------------------------------------------
# Demo subdomain (A record managed in Namecheap DNS, pointed at the Hetzner
# box — configured elsewhere). No scheme, no trailing slash.
DEMO_DOMAIN=edc-demo.example.com

# Contact email for the Let's Encrypt account (expiry notices). Rendered into
# Traefik's static config at container start.
ACME_EMAIL=ops@example.com

# --- OpenClinica UI edge protection ------------------------------------------
# htpasswd users for the Traefik basic-auth middleware in front of the OC web
# UI (OC 3.17 is old software; never expose it bare to the internet).
# Generate:   htpasswd -nB demo
# IMPORTANT: escape every `$` in the hash as `$$` so docker compose does not
# try to interpolate it. Multiple users: comma-separated.
OC_UI_BASICAUTH_USERS=demo:$$2y$$05$$REPLACE_WITH_REAL_HTPASSWD_HASH

# --- OpenClinica database (Postgres 9.5) -------------------------------------
# Superuser password for the postgres container itself (used only by the image
# and the init script; the app never uses the superuser).
OC_DB_SUPERUSER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Application role/database — OC connects as `clinica` to db `openclinica`
# (names fixed by convention in init-db.sh + datainfo.properties; change all
# three together or not at all).
OC_DB_USER=clinica
OC_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OC_DB_NAME=openclinica

# --- OpenClinica app config --------------------------------------------------
# Admin/notification email baked into datainfo.properties.
OC_ADMIN_EMAIL=ops@example.com
# SMTP relay for OC notification mail. The EDC network is internal-only (no
# egress), so mail will NOT leave the enclave unless you run a relay on it;
# for the demo this can stay a dead-end placeholder.
OC_MAIL_HOST=localhost

# --- Rust verify proxy -> OC SOAP credentials (proxy dev wires these) --------
# WS-Security UsernameToken credentials of the OC user the proxy writes as.
# Create this user in the OC UI first (see openclinica/README.md).
OC_WS_USER=ws-proxy
OC_WS_PASSWORD=REPLACE_WITH_OC_WS_USER_PASSWORD

# --- OpenAI (biject-api / agent + scripts/preflight.sh) ----------------------
OPENAI_API_KEY=sk-REPLACE_ME
# Model used by the preflight Responses API probe (and a sane agent default).
OPENAI_MODEL=gpt-4o-mini
