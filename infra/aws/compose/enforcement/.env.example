# =============================================================================
# biject demo — AWS enforcement host (EC2 #1) environment template.
#
# Copy to `.env` NEXT TO docker-compose.yml and fill in REAL values there:
#
#     cp .env.example .env && chmod 600 .env
#
# The real `.env` is NEVER committed. Credential provenance: every value that
# has to be minted by a human is item 1 of
# .claude/handoff/track2-human-gated.md — generation recipes included there.
# This file lists EVERY variable the enforcement compose file reads.
# =============================================================================

# --- Domain / TLS ------------------------------------------------------------
# Demo base domain (no scheme, no trailing slash). Three Namecheap A records —
# proxy.<domain>, wall.<domain>, oc.<domain> — must point at the enforcement
# Elastic IP (terraform output `dns_records` prints them ready to paste).
DEMO_DOMAIN=edc-demo.example.com

# Contact email for the Let's Encrypt account (expiry notices). Rendered into
# Traefik's static config at container start.
ACME_EMAIL=ops@example.com

# Public IPv4 of the presenter's workstation — the ONLY address Traefik's
# ipAllowList admits to the OC UI at oc.<domain>. Must equal the terraform
# `presenter_ip` input (the SG and the middleware gate the same person).
PRESENTER_IP=203.0.113.7

# --- Audit ledger keys (biject-api / biject-trace) ---------------------------
# Ed25519 seed, base64, 32 bytes. biject-api REFUSES TO START without it
# (compose uses :?). Generate:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Rotating it later breaks chain continuity — treat the first value as
# long-lived (handoff item 1).
AUDIT_SIGNING_KEY=REPLACE_WITH_BASE64_32B_ED25519_SEED

# Public half of AUDIT_SIGNING_KEY, derived IN biject-api's environment
# (recipe in biject-trace's CLAUDE.md). Goes to biject-trace only. Unset,
# trace still verifies hash linkage but reports signatures unchecked.
AUDIT_VERIFY_PUBKEY=

# Public half of the AGENT host's AGENT_SIGNING_KEY (see the agent host's
# .env.example) — biject-api uses it for sigOk verification. The private
# agent seed must NEVER appear on this host.
AGENT_VERIFY_PUBKEY=

# --- Proxy -------------------------------------------------------------------
# Inbound API key the proxy requires on every route except the health probes
# (sent as the X-Biject-Proxy-Key header; constant-time compared). The SAME
# value goes on the agent host as BIJECT_PROXY_API_KEY. Left unset, every
# gated route refuses with `auth_not_configured` — fail-closed by design.
PROXY_API_KEY=REPLACE_WITH_RANDOM_TOKEN

# Shared ingest token between biject-proxy and biject-trace for the wall
# feed (trace's POST /v1/verdicts). Optional but strongly recommended:
# unset means open ingest, and the wall becomes paintable by anything on
# the edge network (never the ledger — that path is untouched by ingest).
TRACE_INGEST_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# Generic forward allowlist, `name=url,name=url`. Empty means every generic
# forward is refused with `unknown_target` — the correct default. The demo's
# OpenClinica routes do NOT use this; they are configured below.
PROXY_TARGETS=

# Timeouts/skew (defaults shown; a verify timeout is a denial budget, not a
# latency target).
VERIFY_TIMEOUT_MS=2000
FORWARD_TIMEOUT_MS=10000
AUDIT_SKEW_MS=5000

# --- OpenClinica service account (proxy -> OC) -------------------------------
# OC user the proxy acts as. Create it in the OC UI FIRST, with "Authorize
# SOAP web services in this account" CHECKED — the ws interceptor rejects
# otherwise (handoff item 1).
OPENCLINICA_USERNAME=ws-proxy
# Session (form-login) password — used for ODM reads.
OPENCLINICA_PASSWORD=REPLACE_WITH_OC_USER_PASSWORD
# !! WS-Security wants the SHA-1 HEX OF THE PASSWORD, not the password !!
# The OC3 ws WAR compares against the stored SHA-1 hash. Derive:
#   python3 -c "import hashlib,sys; print(hashlib.sha1(sys.argv[1].encode()).hexdigest())" 'THE_PASSWORD'
# (Run locally, not on a shared shell — the password lands in shell history.)
OPENCLINICA_WS_PASSWORD=REPLACE_WITH_SHA1_HEX_OF_PASSWORD
# ODM metadata version OID stamped into writes (default v1.0.0).
OPENCLINICA_METADATA_VERSION_OID=v1.0.0

# --- OpenClinica database (Postgres 9.5) -------------------------------------
# Superuser password for the postgres container itself (init only; the app
# never uses the superuser).
OC_DB_SUPERUSER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Application role/database — OC connects as `clinica` to db `openclinica`
# (names fixed by convention in init-db.sh + datainfo.properties; change all
# three together or not at all).
OC_DB_USER=clinica
OC_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OC_DB_NAME=openclinica

# --- OpenClinica app config --------------------------------------------------
# Admin/notification email baked into datainfo.properties.
OC_ADMIN_EMAIL=ops@example.com
# SMTP relay for OC notification mail. The edc network is internal-only (no
# egress), so mail will not leave the enclave; a dead-end placeholder is fine
# for the demo.
OC_MAIL_HOST=localhost

# Optional second factor in front of the OC UI (the compose file ships the
# basicauth labels commented out; the primary gate is the PRESENTER_IP
# ipAllowList). htpasswd format; escape every `$` as `$$`:
#   htpasswd -nB demo
#OC_UI_BASICAUTH_USERS=demo:$$2y$$05$$REPLACE_WITH_REAL_HTPASSWD_HASH

# --- biject-api optional integrations ----------------------------------------
# Each of these empty disables a feature at the feature — never weakens a
# verdict (see the compose comments).
ORACLE_SIGNING_KEY=
ANTHROPIC_API_KEY=
ARISTOTLE_API_KEY=
