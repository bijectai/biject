# =============================================================================
# biject demo — AWS agent host (EC2 #2) environment template.
#
#     cp .env.example .env && chmod 600 .env
#
# The real `.env` is NEVER committed. Credential provenance: handoff list
# .claude/handoff/track2-human-gated.md item 1.
#
# !! NO OPENCLINICA VARIABLES IN THIS FILE — EVER !! (See the compose header:
# EDC credentials on the agent host would let it bypass the enforcement hop.)
# =============================================================================

# Demo base domain — must match the enforcement host's DEMO_DOMAIN. The agent
# derives its single endpoint from it: https://proxy.<DEMO_DOMAIN>.
DEMO_DOMAIN=edc-demo.example.com

# Same value as PROXY_API_KEY in the enforcement host's .env. Sent as the
# X-Biject-Proxy-Key header; the proxy requires it on every non-health route.
BIJECT_PROXY_API_KEY=REPLACE_WITH_RANDOM_TOKEN

# Calling-agent identity (X-Biject-Agent-Id header). Stable string, e.g.
# "demo-agent-01".
BIJECT_AGENT_ID=demo-agent-01

# The WHO of a data change, carried inside tool-call bodies (actorId).
# Distinct from BIJECT_AGENT_ID by design.
ACTOR_ID=demo-operator

# Ed25519 seed, base64, 32 bytes — the S4-A-30 signing pipeline. Generate:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# THIS HOST ONLY. Derive the public half and hand it to the enforcement host
# as AGENT_VERIFY_PUBKEY; the seed itself never goes there.
AGENT_SIGNING_KEY=REPLACE_WITH_BASE64_32B_ED25519_SEED

# LLM provider (hosted provider, pinned model — handoff item 1).
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
